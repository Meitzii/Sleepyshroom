    {
      "source": "/api/admin/collections/:id",
      "destination": "/api/admin/store?route=collections&id=:id"
    },
    {
      "source": "/api/admin/collections",
      "destination": "/api/admin/store?route=collections"
    },
    {
      "source": "/api/admin/bundles/:id",
      "destination": "/api/admin/store?route=bundles&id=:id"
