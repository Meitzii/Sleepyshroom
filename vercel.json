      "source": "/api/admin/faqs",
      "destination": "/api/admin/store?route=faqs"
    },
    {
      "source": "/((?!assets/|wallpapers/|images/|uploads/|src/|api/).*)",
      "destination": "/index.html"
    }
  ]
