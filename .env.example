# Supabase (Public client credentials - safe for frontend runtime config)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Supabase Server Key (Server-only - NEVER prefix with VITE_ or expose in frontend)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Email Delivery via Resend (Server-only - NEVER expose in frontend)
RESEND_API_KEY="re_your_resend_api_key"
# Verified sender in Resend (e.g., "sleepyshroom <support@yourdomain.com>")
# Required to reply to external customer emails directly from Admin Dashboard
RESEND_FROM_EMAIL="Sleepyshroom Contact <onboarding@resend.dev>"

# PayPal Checkout API (Server-only - NEVER prefix with VITE_ or expose secrets in frontend)
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_WEBHOOK_ID="your-paypal-webhook-id"
# Set to "sandbox" for PayPal Sandbox testing or "live" for real production payments
PAYPAL_ENVIRONMENT="sandbox"
